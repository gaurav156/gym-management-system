VITE_API_URL=http://localhost:8080
VITE_GYM_NAME=Gym Name
VITE_GYM_LOGO_URL=/logo.svg
VITE_HERO_LOGO_OUTER_URL=
VITE_HERO_LOGO_INNER_URL=
VITE_GYM_NAME_FONT=
VITE_GYM_NAME_FONT_URL=
# TrueType (.ttf) file of the name font, used only inside invoice PDFs. Leave blank for Helvetica Bold.
VITE_GYM_NAME_FONT_FILE_URL=
VITE_DIRECTOR_NAME=Gym Owner
VITE_INVOICE_TERMS=Fees must be paid before 10th of every months.|The membership will be cancelled if the dues are not paid by the member for two months.|Regarding all members the Director's decision will be final.|Fees once paid will not be refund, not transferable & not extendable.
# Cloudflare Turnstile site key - the value below is Cloudflare's published TEST site key
# (always passes, no real protection). Replace with your real site key before deploying:
# https://dash.cloudflare.com/?to=/:account/turnstile
VITE_TURNSTILE_SITE_KEY=

# Landing page - About Us section
VITE_GYM_ESTABLISHED_YEAR=1995
# Optional - a real photo of the Director. Leave blank to show an initials avatar
# instead (built from VITE_DIRECTOR_NAME) rather than a placeholder stock photo.
VITE_DIRECTOR_PHOTO_URL=

# Landing page - Contact section and footer
VITE_SUPPORT_EMAIL=hello@mygym.com
# Full profile URLs, not just handles - e.g. https://instagram.com/yourgym
VITE_INSTAGRAM_URL=https://instagram.com/
VITE_FACEBOOK_URL=https://facebook.com/