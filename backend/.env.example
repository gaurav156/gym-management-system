# Copy to .env (or set these as real environment variables) - never commit real secrets
DB_URL=jdbc:postgresql://<your-supabase-or-neon-host>:5432/<db-name>
DB_USERNAME=postgres
DB_PASSWORD=your-db-password

JWT_SECRET=replace-with-a-long-random-string-at-least-32-characters
JWT_EXPIRATION_MS=86400000
JWT_REMEMBER_ME_EXPIRATION_MS=2592000000

CORS_ORIGIN=http://localhost:5173

# Local HTTPS only (mkcert, shares the cert in frontend/.cert/) - leave false for
# Render/production, where TLS is terminated at the platform level
SSL_ENABLED=false
SSL_KEYSTORE_PASSWORD=changeit

# Primary Owner. Seeded on first startup, and protected: while this value matches its email
# that account can't be demoted or deleted, and it receives the verification codes for
# demoting other Owners. To retire it, change this value (and restart) first.
OWNER_EMAIL=owner@mygym.com
OWNER_PASSWORD=ChangeMe123!
OWNER_NAME=Gym Owner

# Password reset OTP - email delivery via SMTP. Gmail SMTP is free and works well for
# this: enable 2FA on the Gmail account, then create an App Password at
# https://myaccount.google.com/apppasswords and use it as SMTP_PASSWORD.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-gmail-address@gmail.com
SMTP_PASSWORD=your-16-char-app-password
MAIL_FROM=your-gmail-address@gmail.com
OTP_EXPIRY_MINUTES=10

# Used only for the OTP email template's header - keep these in sync with the frontend's
# VITE_GYM_NAME / VITE_GYM_LOGO_URL if you want the email to match the app's branding.
# GYM_LOGO_URL must be a publicly reachable image URL (png/jpg preferred - many email
# clients render inline SVG poorly or not at all). Leave blank to show a text-only header.
GYM_NAME=FitZone Gym
GYM_LOGO_URL=https://your-domain.com/logo.png

# CAPTCHA (Cloudflare Turnstile) - required after a few failed/attempted requests from
# the same IP on login, register, and password-reset OTP requests, to blunt scripted
# abuse. The secret key below is Cloudflare's published TEST secret - it always verifies
# successfully, paired with the test site key in frontend/.env.example. Fine for local
# dev; replace both with real keys from your Cloudflare dashboard before deploying:
# https://dash.cloudflare.com/?to=/:account/turnstile
CAPTCHA_ENABLED=true
CAPTCHA_MAX_ATTEMPTS=3
CAPTCHA_WINDOW_MINUTES=15
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Base URL of the deployed frontend - used to build the "View / Download Invoice" link
# in emailed invoices. Set to your Netlify URL in production.
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------------------------------
# Image storage (profile photos & signatures) - any S3-compatible object store.
# The database stores only object KEYS (e.g. avatars/<uuid>.jpg); URLs are built from
# STORAGE_PUBLIC_BASE_URL, so switching provider needs no DB migration. See README section 6.
# ---------------------------------------------------------------------------------------

# Only "s3" exists today (covers MinIO, Cloudflare R2, AWS S3, Supabase Storage, Backblaze B2).
STORAGE_PROVIDER=s3

# S3 API endpoint the BACKEND talks to. Leave blank for real AWS S3.
#   MinIO (plain HTTP):   http://localhost:9000
#   MinIO (TLS/mkcert):   https://localhost:9000   (the JVM must trust the mkcert root CA - README 6.2)
#   Cloudflare R2:        https://<account-id>.r2.cloudflarestorage.com
#   Supabase:             copy from Storage -> S3 Connection
STORAGE_S3_ENDPOINT=https://localhost:9000

# "us-east-1" is fine for MinIO. Use "auto" for Cloudflare R2; the real region for AWS/Supabase.
STORAGE_S3_REGION=us-east-1

# Bucket name. Must allow public read (objects have unguessable UUID names) and, in production,
# a CORS rule allowing GET from your frontend origin (the invoice PDF fetches the signature image).
STORAGE_S3_BUCKET=gym-media

# Credentials with read/write on the bucket. For local MinIO these are its root user/password
# (docker-compose.yml reads MINIO_ROOT_USER / MINIO_ROOT_PASSWORD from a root-level .env).
# Never commit real production keys.
STORAGE_S3_ACCESS_KEY=minioadmin
STORAGE_S3_SECRET_KEY=minioadmin

# true for MinIO and Supabase, false for AWS S3 and Cloudflare R2.
STORAGE_S3_PATH_STYLE=true

# Base URL BROWSERS use to load images (not necessarily the same as the endpoint above).
#   MinIO over TLS:               https://<your-lan-ip>:9000/gym-media
#   MinIO behind the Vite proxy:  /media   (relative; works from localhost and LAN IP)
#   Cloudflare R2:                https://media.yourdomain.com   (custom domain, not r2.dev, in prod)
#   Supabase:                     https://<ref>.supabase.co/storage/v1/object/public/<bucket>
#   AWS S3:                       https://<bucket>.s3.<region>.amazonaws.com (or a CloudFront domain)
STORAGE_PUBLIC_BASE_URL=https://192.168.0.192:9000/gym-media

# One-shot: set to true for a single startup to convert existing base64 photos/signatures into
# bucket objects, then set back to false. Back up the database first.
STORAGE_MIGRATE_LEGACY=false

# Orphaned-image cleanup - deletes stored images no user references (e.g. uploaded in a form
# that was never saved). Runs daily.
STORAGE_CLEANUP_ENABLED=true
# Spring cron: second minute hour day month weekday (server time).
STORAGE_CLEANUP_CRON=0 30 3 * * *
# Only objects older than this are eligible, so a form left open for a while isn't broken.
STORAGE_CLEANUP_MIN_AGE_HOURS=24
# Safety brake: if more than this many objects look orphaned, the run aborts and logs an error
# (usually means the wrong/empty database) instead of deleting.
STORAGE_CLEANUP_MAX_DELETE=200
# true = only log what WOULD be deleted. Recommended for the first run in production.
STORAGE_CLEANUP_DRY_RUN=false