# Copy to .env (or set these as real environment variables) - never commit real secrets
DB_URL=jdbc:postgresql://<your-supabase-or-neon-host>:5432/<db-name>
DB_USERNAME=postgres
DB_PASSWORD=your-db-password

JWT_SECRET=replace-with-a-long-random-string-at-least-32-characters
JWT_EXPIRATION_MS=86400000

CORS_ORIGIN=http://localhost:5173

OWNER_EMAIL=owner@mygym.com
OWNER_PASSWORD=ChangeMe123!
OWNER_NAME=Gym Owner
